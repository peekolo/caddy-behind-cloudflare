# Host record for caddy-behind-cloudflare scripts (bin/*). Sourced by bash: KEY=value, no spaces around =.
NAME=myhost
TYPE=shared                      # shared | individual
PROVIDER="Vultr, New Jersey"     # example (203.0.113.0/24 is a documentation range)
IP=203.0.113.10                  # public IPv4; the box has no IPv6
SSH=myhost_deploy                # ssh alias for the deploy user (on the machine that runs the scripts)
ADMIN_SSH=myhost                 # ssh alias for the sudo admin (serverbeef --user), owner-only root steps
OS="Ubuntu 26.04, 4 vCPU / 7.2 GB / 150 GB"
PROJECTS="shop blog"             # one /srv/<project> each; site files sites/<project>.caddy
ALIASES="sh-web:3000 bl-web:8080 bl-api:8080"  # unique on this host (CLAUDE.md section 2)
