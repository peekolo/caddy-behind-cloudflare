#!/usr/bin/env bash
# proxy-install <host> [--dry-run]: install or update the shared Caddy in ~/srv/proxy (deploy's home) on a host, from this repo's proxy/.
# Runs on the workstation, connects as the deploy user. Idempotent. Never touches project-owned files:
# conf/sites/*.caddy, certs/*, .env (created once from .env.example with the box's gateway in LOCAL_RANGES).
source "$(dirname "$0")/../lib/common.sh"
need ssh rsync
H=${1:-}; [[ -n "$H" && "$H" != -* ]] || die "usage: bin/proxy-install <host> [--dry-run]"
[[ "${2:-}" == --dry-run ]] && DRY_RUN=1
load_host "$H"

step "1. reach $HOST_SSH as deploy"
on_host "docker info --format '{{.SecurityOptions}}' 2>/dev/null" | grep -q rootless \
  || die "deploy on $HOST_NAME has no rootless Docker daemon (serverbeef with Docker, rootless, run by deploy)"
if on_host "test -d $PROXY_DIR"; then ok "deploy@$HOST_NAME, rootless Docker, ~/$PROXY_DIR exists"
elif act "mkdir ~/$PROXY_DIR as deploy"; then on_host "install -d -m 755 $PROXY_DIR"; ok "deploy@$HOST_NAME, rootless Docker, ~/$PROXY_DIR created"; fi

step "2. network $PROXY_NET ($PROXY_SUBNET)"
have=$(on_host "docker network inspect -f '{{range .IPAM.Config}}{{.Subnet}}{{end}}' $PROXY_NET 2>/dev/null" || true)
if [[ "$have" == "$PROXY_SUBNET" ]]; then ok "exists"
elif [[ -n "$have" ]]; then die "network $PROXY_NET exists with subnet $have, expected $PROXY_SUBNET"
elif act "docker network create --subnet $PROXY_SUBNET $PROXY_NET"; then on_host "docker network create --subnet $PROXY_SUBNET $PROXY_NET" >/dev/null; ok created
fi

step "3. proxy files"
RS=(rsync -rlt --checksum --itemize-changes --chmod=Dg+ws,Fg+w --exclude .env --exclude 'certs/*.pem' --exclude 'certs/*.key'
    --exclude 'certs/*.csr' --exclude 'conf/sites/*.caddy' --exclude .gitignore)
changes=$("${RS[@]}" --dry-run "$AIDEPLOY/proxy/" "$HOST_SSH:$PROXY_DIR/" | grep -v '^\.' || true)
if [[ -z "$changes" ]]; then ok "already current"
else
  printf '%s\n' "$changes" | sed 's/^/       /'
  if act "rsync proxy/ -> $PROXY_DIR"; then "${RS[@]}" "$AIDEPLOY/proxy/" "$HOST_SSH:$PROXY_DIR/" >/dev/null; ok synced; fi
fi
# A smoke check on the box (curl --resolve <host>:443:127.0.0.1) reaches caddy from the proxy gateway (rootful) or,
# through rootless Docker's pasta, from rootlesskit's namespace address 10.0.2.100 (measured on two serverbeef hosts, 2026-10-23).
ROOTLESS_LOCAL=10.0.2.100/32
if on_host "test -f $PROXY_DIR/.env"; then
  ok ".env kept"
  if on_host "docker info --format '{{.SecurityOptions}}'" | grep -q rootless && ! on_host "grep -q '^LOCAL_RANGES=.*$ROOTLESS_LOCAL' $PROXY_DIR/.env"; then
    if act "add $ROOTLESS_LOCAL (rootless loopback) to LOCAL_RANGES in .env"; then
      on_host "cd $PROXY_DIR && sed -i 's#^LOCAL_RANGES=.*#& $ROOTLESS_LOCAL#' .env"; ok "LOCAL_RANGES: $(on_host "sed -n 's/^LOCAL_RANGES=//p' $PROXY_DIR/.env")"
    fi
  fi
elif act "create .env (LOCAL_RANGES: proxy gateway + rootless loopback, what a local smoke check looks like)"; then
  on_host "cd $PROXY_DIR && sed 's#^LOCAL_RANGES=.*#LOCAL_RANGES=10.89.0.1/32 $ROOTLESS_LOCAL#' .env.example > .env && chmod 640 .env"; ok ".env created"
fi

step "4. start / update caddy"
if act "docker compose up -d --wait"; then
  on_host "cd $PROXY_DIR && docker compose up -d --wait 2>&1 | tail -2 && ./reload.sh 2>&1 | grep -vE '\"level\":\"(info|warn)\"'"
fi
on_host "docker ps --format '{{.Names}}\t{{.Status}}\t{{.Ports}}'" | awk -F'\t' '$3 ~ /0\.0\.0\.0|:::|\[::\]/ {print "       publishes host ports: " $1 " (" $2 ")"}'
echo; echo "Next: bin/site-add for each project (see CLAUDE.md, 'Add a project')."
