# /srv/proxy/.env
# gid of the deploy user: caddy (uid 1000) gets it as a supplementary group to read certs/*.key (mode 640, group deploy)
DEPLOY_GID=1001
# Sources that may reach the sites without coming through Cloudflare: the proxy network's gateway, which is what a
# local `curl --resolve host:443:127.0.0.1` (deploy smoke checks) looks like from inside the container.
LOCAL_RANGES=10.89.0.1/32
