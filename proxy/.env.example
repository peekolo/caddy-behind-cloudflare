# ~/srv/proxy/.env on the host (bin/proxy-install creates it once from this file)
# Sources that may reach the sites without coming through Cloudflare: smoke checks run on the box itself
# (`curl --resolve <host>:443:127.0.0.1`). Inside the container such a connection shows up as the proxy network's
# gateway, or, through rootless Docker's pasta networking, as the box's default gateway; proxy-install adds that one.
LOCAL_RANGES=10.89.0.1/32
